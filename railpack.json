{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": [
    "ca-certificates",
    "git",
    "unzip",
    "zip",
    "libpng-dev",
    "libjpeg-dev",
    "libfreetype6-dev"
  ],
  "steps": {
    "build": {
      "commands": [
        "npm run build",
        "composer install --optimize-autoloader --no-scripts --no-interaction"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "ca-certificates",
      "libpng-dev",
      "libjpeg-dev",
      "libfreetype6-dev"
    ],
    "startCommand": "php artisan migrate --force --seed && php artisan serve --host=0.0.0.0 --port=${PORT:-8000}"
  }
}